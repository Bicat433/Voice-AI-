{
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "lookup_patient_by_phone",
        "description": "Look up an existing patient record by phone number. Call this as soon as you have a valid 10-digit US phone number to check for duplicates.",
        "parameters": {
          "type": "object",
          "properties": {
            "phone_number": {
              "type": "string",
              "description": "US 10-digit phone number (digits only, no formatting)"
            }
          },
          "required": ["phone_number"]
        }
      },
      "server": {
        "url": "{{API_BASE_URL}}/vapi/lookup_patient"
      }
    },
    {
      "type": "function",
      "function": {
        "name": "create_patient",
        "description": "Create a new patient record. Only call after the caller has explicitly confirmed all collected information.",
        "parameters": {
          "type": "object",
          "properties": {
            "first_name": { "type": "string", "description": "Patient first name (1-50 chars, letters/hyphens/apostrophes)" },
            "last_name": { "type": "string", "description": "Patient last name (1-50 chars, letters/hyphens/apostrophes)" },
            "date_of_birth": { "type": "string", "description": "Date of birth in YYYY-MM-DD format" },
            "sex": { "type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"] },
            "phone_number": { "type": "string", "description": "US 10-digit phone number (digits only)" },
            "email": { "type": "string", "description": "Email address (optional)" },
            "address_line_1": { "type": "string", "description": "Street address line 1" },
            "address_line_2": { "type": "string", "description": "Street address line 2 (optional)" },
            "city": { "type": "string", "description": "City (1-100 chars)" },
            "state": { "type": "string", "description": "2-letter US state abbreviation" },
            "zip_code": { "type": "string", "description": "5-digit or ZIP+4 format" },
            "insurance_provider": { "type": "string", "description": "Insurance provider name (optional)" },
            "insurance_member_id": { "type": "string", "description": "Insurance member ID, alphanumeric (optional)" },
            "preferred_language": { "type": "string", "description": "Preferred language (default English)" },
            "emergency_contact_name": { "type": "string", "description": "Emergency contact name (optional)" },
            "emergency_contact_phone": { "type": "string", "description": "Emergency contact 10-digit phone (optional)" }
          },
          "required": [
            "first_name",
            "last_name",
            "date_of_birth",
            "sex",
            "phone_number",
            "address_line_1",
            "city",
            "state",
            "zip_code"
          ]
        }
      },
      "server": {
        "url": "{{API_BASE_URL}}/vapi/create_patient"
      }
    },
    {
      "type": "function",
      "function": {
        "name": "update_patient",
        "description": "Update an existing patient record. Only call after the caller has explicitly confirmed all information. Use patient_id from lookup_patient_by_phone result.",
        "parameters": {
          "type": "object",
          "properties": {
            "patient_id": { "type": "string", "description": "UUID of the patient to update" },
            "first_name": { "type": "string" },
            "last_name": { "type": "string" },
            "date_of_birth": { "type": "string", "description": "YYYY-MM-DD" },
            "sex": { "type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"] },
            "phone_number": { "type": "string" },
            "email": { "type": "string" },
            "address_line_1": { "type": "string" },
            "address_line_2": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "zip_code": { "type": "string" },
            "insurance_provider": { "type": "string" },
            "insurance_member_id": { "type": "string" },
            "preferred_language": { "type": "string" },
            "emergency_contact_name": { "type": "string" },
            "emergency_contact_phone": { "type": "string" }
          },
          "required": ["patient_id"]
        }
      },
      "server": {
        "url": "{{API_BASE_URL}}/vapi/update_patient"
      }
    }
  ]
}
